# Clerk (admin auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MongoDB
MONGODB_URI=
MONGODB_DB=annybakes

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (Resend). Emails are skipped until RESEND_API_KEY and EMAIL_FROM are set.
# EMAIL_FROM must use a domain verified in Resend, e.g. "Anny Bakes <orders@annybakes.com>".
# EMAIL_ADMIN receives new-order alerts and customer replies.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ADMIN=

# Cloudinary — admin product photo uploads (Settings → API Keys in the Cloudinary console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App — the public site URL; used for Stripe redirects and admin links in emails
NEXT_PUBLIC_BASE_URL=http://localhost:3000
